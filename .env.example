# Port the OpenAI-compatible proxy listens on
PORT=8741

# Local OAuth callback port. Must stay free while logging in; Figma redirects here.
CALLBACK_PORT=8742

# Optional: require clients to send "Authorization: Bearer <key>" to this proxy.
# Leave empty to run unauthenticated (fine for localhost use).
PROXY_API_KEY=

# Target Figma file that generated images are placed into.
# Accepts a raw file key or a full file URL, e.g.
#   FIGMA_FILE_KEY=https://www.figma.com/design/AbCdEf123456/MyFile
FIGMA_FILE_KEY=

# Figma image model used when a request doesn't specify one. Options:
#   gemini-3.1-flash-lite-image | gpt-image-2.5-flare (Figma default)
#   gpt-image-2.5-sunburst      | gemini-3.1-flash-image
FIGMA_MODEL=gpt-image-2.5-sunburst

# Set to 1 to KEEP generated images on the Figma canvas after download.
# By default the generated node is deleted so the file stays clutter-free.
FIGMA_KEEP_IMAGES=

# Figma's image models cap their native output at 1536px on the long edge
# (1024px square). Requesting a bigger size — e.g. "1920x1080" — is served by
# upscaling with Lanczos3 + a light unsharp mask. Set FIGMA_UPSCALE=0 to return
# Figma's native pixels untouched instead.
FIGMA_UPSCALE=1

# Applied when a request omits "size". Leave empty to return native resolution.
# FIGMA_DEFAULT_SIZE=1920x1080

# Default output format: png | jpeg | webp (per-request "output_format" wins).
FIGMA_OUTPUT_FORMAT=png

# Overrides (sensible defaults)
FIGMA_MCP_URL=https://mcp.figma.com/mcp
MODEL_ID=figma-image-1
# OAuth tokens are persisted here so you only log in once
TOKEN_STORE=.figma-auth.json
